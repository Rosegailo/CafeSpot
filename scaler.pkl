import pickle
import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# 1. Load cleaned dataset
df = pd.read_csv("cleaned_cafes.csv")

# 2. Extract features used by app.py
df["LogReviews"] = np.log1p(df["NumReview"])
features = ["Latitude", "Longitude", "Rating", "LogReviews"]
X = df[features]

# 3. Fit StandardScaler and save to scaler.pkl
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

with open("scaler.pkl", "wb") as f:
    pickle.dump(scaler, f)

# 4. Fit KMeans model and save to kmeans_model.pkl
kmeans_model = KMeans(n_clusters=5, random_state=42, n_init=10)
df["Cluster"] = kmeans_model.fit_predict(X_scaled)

with open("kmeans_model.pkl", "wb") as f:
    pickle.dump(kmeans_model, f)

print("Successfully generated scaler.pkl and kmeans_model.pkl!")